# Copier en config.env (ignoré par Git) puis adapter.
# Les identifiants AWS ne vont PAS ici : `aws configure` ou AWS_PROFILE.
REGION=eu-west-3
AZ=eu-west-3a
MON_IP=203.0.113.7            # votre IP publique (curl -s https://checkip.amazonaws.com)
TYPE_PLATEFORME=c7i.4xlarge   # CPU 16 vCPU : pas de quota GPU sur notre compte (g4dn.xlarge si un jour)
TYPE_PRIVE=t3.small
NOM_CLE=sas-pme
