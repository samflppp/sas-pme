[Unit]
Description=pypiserver sas-pme (versions approuvées seulement, aucun repli vers pypi.org)
After=network-online.target

[Service]
User=pypi
Group=pypi
Environment=PYTHONPATH=/opt/pypiserver
# --disable-fallback : un paquet absent renvoie 404 au lieu d'une redirection vers pypi.org.
# Pas de -P/-a : l'envoi (upload) reste refusé ; seules les copies de la plateforme publient.
# Journal d'accès (lu par /v1/inventory). La date vient du préambule (--log-frmt, %(asctime)s) ;
# le message de requête (--log-req-frmt) n'a que des clés du WSGI environ (REMOTE_ADDR = l'IP du
# serveur, PATH_INFO = /packages/<archive>) — %(asctime)s n'y est PAS disponible. Le code HTTP
# n'existe pas au moment du log de requête : passerelle/inventaire.py le tolère et ne compte que
# les GET /packages/<archive> (une archive servie prouve une installation). Format d'une ligne :
#   2026-10-11 09:00:01 10.42.2.20 - - "GET /packages/requests-2.32.4-...whl HTTP/1.1"
Environment=SAS_JOURNAL_ACCES=/var/lib/sas/pypiserver-acces.log
ExecStart=/usr/bin/python3 -m pypiserver run --host 0.0.0.0 --port 8080 --disable-fallback -v \
  --log-file /var/lib/sas/pypiserver-acces.log \
  --log-frmt "%(asctime)s %(message)s" \
  --log-req-frmt "%(REMOTE_ADDR)s - - \"%(REQUEST_METHOD)s %(PATH_INFO)s %(SERVER_PROTOCOL)s\"" \
  /srv/pypi/packages
# /var/lib/sas est créé par installer.sh en pypi:pypi, mode 2770 (setgid) : pypi y écrit son
# journal, et le récepteur (membre du groupe pypi) y écrit nonces.txt. On N'utilise PAS
# StateDirectory= ici : les deux services tourneraient sous des utilisateurs différents (pypi,
# recepteur) et systemd réécrirait le propriétaire du répertoire au démarrage de chacun, cassant
# l'écriture de l'autre. ReadWritePaths ouvre l'écriture sous ProtectSystem=strict sans toucher
# au propriétaire.
ReadWritePaths=/var/lib/sas
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/srv/pypi

[Install]
WantedBy=multi-user.target
