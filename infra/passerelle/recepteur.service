[Unit]
Description=récepteur sas-pme (publications signées de la plateforme, TLS mutuel)
After=network-online.target

[Service]
User=recepteur
Group=recepteur
SupplementaryGroups=pypi
Environment=PYTHONPATH=/opt/recepteur/code:/opt/recepteur/lib
Environment=SAS_DEPOT=/srv/pypi/packages
Environment=SAS_CLE_PUBLIQUE=/etc/sas/plateforme_signature.pub
Environment=SAS_NONCES=/var/lib/sas/nonces.txt
Environment=SAS_JOURNAL_ACCES=/var/lib/sas/pypiserver-acces.log
Environment=SAS_REGISTRE=/var/lib/sas/registre.txt
# --ssl-cert-reqs 2 : certificat client exigé, signé par l'autorité du lien (la plateforme seule).
ExecStart=/usr/bin/python3 -m uvicorn passerelle.recepteur:app --host 10.42.2.10 --port 8443 \
  --ssl-keyfile /etc/sas/passerelle.key --ssl-certfile /etc/sas/passerelle.pem \
  --ssl-ca-certs /etc/sas/ca.pem --ssl-cert-reqs 2
# Voir pypiserver.service : /var/lib/sas est partagé (pypi:pypi, 2770), créé par installer.sh.
# Pas de StateDirectory= (sinon systemd en ferait recepteur:recepteur au démarrage, cassant
# l'écriture du journal par pypi). ReadWritePaths suffit : le récepteur y écrit nonces.txt via le
# bit group-write, et y lit le journal via son appartenance au groupe pypi (SupplementaryGroups).
ReadWritePaths=/var/lib/sas /srv/pypi/packages
UMask=0022
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
